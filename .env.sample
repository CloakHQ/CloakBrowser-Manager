# Copy to .env (gitignored) and fill in what you need. `docker compose` reads
# .env automatically — nothing here needs to be exported by hand.

# --- CloakBrowser ---------------------------------------------------------
# Pro license key. Downloaded and validated at container LAUNCH, not build
# time — see the "License" section of README.md. Leave empty for the free
# tier (1 concurrent session, no key required).
CLOAKBROWSER_LICENSE_KEY=

# --- Auth / exposure -------------------------------------------------------
# Always required — there is no open mode. Leave this empty and the container
# generates a random 32-character token on first boot, prints it loudly to
# `docker compose logs manager`, and saves it to /data/auth_token so a
# restart keeps the same value. Set it here instead to pin your own.
AUTH_TOKEN=

# Stop a profile automatically after this many idle seconds (no VNC viewer, no
# CDP traffic) to release its CloakBrowser license claim. Per-profile override
# in the form; 0 there disables idle timeout for that profile.
PROFILE_IDLE_TIMEOUT_SECONDS=3600

# Extra names/addresses for the self-signed TLS cert's SAN list, comma
# separated (e.g. 192.168.1.50,manager.lan). localhost/127.0.0.1 are always
# included. Only read the first time the cert is generated — delete
# ~/.cloakbrowser-manager/tls to re-issue after changing this.
TLS_SANS=

# --- KasmVNC ----------------------------------------------------------------
# server-authoritative (default): JPEG/WebP only, no client override.
# video: enables H.264/H.265/AV1 WebCodecs streaming, client-authoritative
# quality. See the KASM_ENCODING_POLICY note in README.md before changing.
KASM_ENCODING_POLICY=server-authoritative
# Encoder(s) offered under KASM_ENCODING_POLICY=video. Software: h264, h265,
# av1. VAAPI (Intel/AMD): h264_vaapi, h265_vaapi, av1_vaapi. NVENC (NVIDIA):
# h264_nvenc, h265_nvenc/hevc_nvenc, av1_nvenc.
KASM_VIDEO_CODEC=h264
# text | balanced | low | motion
KASM_QUALITY_PRESET=balanced
# 0-100; raise to 100 to see per-connection encoder decisions in the logs.
KASM_XVNC_LOG_LEVEL=30
# auto | 1 | 0 — DRI3 GPU screen capture.
KASM_HW3D=auto
KASM_DRINODE=/dev/dri/renderD128

# --- Chromium GPU -----------------------------------------------------------
# auto | 1/nvidia | igpu/vaapi/mesa/intel/amd | 0
CHROME_GPU_ACCEL=auto
# Mesa (Intel/AMD) path only: gl-egl | vulkan | gl
CHROME_ANGLE_BACKEND=

# --- Cloudflare Tunnel (the `tunnel` service, on by default) ---------------
# Named tunnel token from the Cloudflare dashboard. Leave empty for a free
# quick tunnel on a random *.trycloudflare.com name (regenerated every
# restart).
CF_TUNNEL_TOKEN=
# Origin the tunnel proxies to. Only change this if the manager service is
# renamed or moved.
CF_TUNNEL_ORIGIN=http://manager:8080
# Set to 1 only if you intentionally want the tunnel to publish the Manager
# with no AUTH_TOKEN set. Refused otherwise.
TUNNEL_ALLOW_NO_AUTH=
