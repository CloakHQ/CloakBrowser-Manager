# CloakBrowser Manager configuration.
# Copy this file to `.env` (in this same directory) and fill it in once.
#   cp .env.example .env
# Loaded automatically at startup (Docker and native). Never commit `.env`.

# A CloakBrowser license key. Seeded into the key pool at startup, so it behaves
# like any key added there: one concurrent profile per key. Add more in the UI
# (Settings -> Key pool) to run profiles side by side. Leave blank to run the
# free keyless build. Get a key (free GitHub key or paid) at cloakbrowser.dev.
CLOAKBROWSER_LICENSE_KEY=

# Which build to download/run: "stable" (default) or "preview".
# Preview needs a valid key; ignored on the keyless build.
CLOAKBROWSER_RELEASE_CHANNEL=stable

# Optional: require this bearer token / cookie to use the Manager. Blank = open.
AUTH_TOKEN=

# Optional: how many files one profile may hold — files you upload to it, plus files
# its browser downloads. Plain byte counts, read once at startup. Shown at their
# defaults; uncomment to change. Nothing is evicted at a limit: a file over the first
# is refused with 413, one that would breach the others with 507. Unset or blank
# means the default; a non-numeric value stops the Manager from starting.
#ARTIFACT_MAX_BYTES=268435456
#ARTIFACT_MAX_COUNT=200
#ARTIFACT_MAX_TOTAL_BYTES=2147483648
